  <name>ordermet</name>
  <uuid>c55bb8e1-60e1-4387-9870-a3709814fe6e</uuid>
  <locales>en_US</locales>
  <operations operationName="operation">
    <operation href="operation.dop#be2785e1-cbbb-4811-9f3c-e09087bd33e7"/>
    <properties key="ruleset.version">
      <value><![CDATA[1.0]]></value>
